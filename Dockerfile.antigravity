# syntax=docker/dockerfile:1.7

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  HOME=/home/agent \
  XDG_CACHE_HOME=/home/agent/.cache \
  XDG_CONFIG_HOME=/home/agent/.config \
  PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  PYTHONPATH=/app/src

# Базовые системные зависимости.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  bash \
  ca-certificates \
  curl \
  ffmpeg \
  git \
  gnupg \
  passwd \
  tini

# Node.js 22.x.
RUN bash -o pipefail -c \
  'curl -fsSL https://deb.nodesource.com/setup_22.x | bash -' \
  && apt-get install -y --no-install-recommends nodejs

# Проверка Node.js и системных команд.
RUN test -x /usr/sbin/useradd \
  && /usr/bin/node --version \
  && /usr/bin/npm --version

# Самый свежий npm.
RUN npm install --global npm@latest \
  && npm --version

# Актуальные Unbrowse и Playwright MCP.
RUN npm install --global \
  unbrowse@latest \
  @playwright/mcp@latest \
  imap-mcp-server@2.0.0 \
  && command -v unbrowse \
  && command -v playwright-mcp \
  && command -v imap-mcp-server \
  && unbrowse --version \
  && imap-mcp-server --version

# Обновление pip и установка uv.
# Antigravity SDK здесь не устанавливается.
RUN python -m pip install --no-cache-dir --upgrade \
  pip \
  setuptools \
  wheel \
  && python -m pip install --no-cache-dir --upgrade uv \
  && python --version \
  && uv --version

# Создание пользователя и доступных ему каталогов.
RUN /usr/sbin/useradd \
  --create-home \
  --uid 1000 \
  --shell /bin/bash \
  agent \
  && rm -rf /home/agent/.imap-mcp \
  && /usr/bin/install -d \
  -o agent \
  -g agent \
  -m 0700 \
  /home/agent/.imap-mcp \
  && /usr/bin/install -d \
  -o agent \
  -g agent \
  -m 0755 \
  /app \
  /home/agent/.cache \
  /home/agent/.cache/antigravity \
  /home/agent/.config \
  /home/agent/.config/gcloud \
  /home/agent/.local \
  /home/agent/.local/bin \
  /home/agent/.gemini \
  /home/agent/.gemini/config \
  /home/agent/.gemini/config/skills \
  /home/agent/.unbrowse \
  && /usr/bin/chown -R agent:agent /home/agent

# Очистка кэша apt.
RUN apt-get clean \
  && find /var/lib/apt/lists -mindepth 1 -delete

USER agent

# Проверяем права до запуска установщика.
RUN test -w "${HOME}" \
  && test -w "${XDG_CACHE_HOME}" \
  && test -w "${XDG_CACHE_HOME}/antigravity" \
  && test -w "${HOME}/.local" \
  && test -w "${HOME}/.gemini"

# Актуальная Antigravity CLI.
RUN bash -o pipefail -c \
  'curl -fsSL https://antigravity.google/cli/install.sh | bash' \
  && command -v agy \
  && agy --version

# MarkItDown service uses MCP 2.0 because Antigravity probes `server/discover` (2026-07-28).
# Python Playwright is required by Harness browser automation, independently of the Node MCP package.
RUN python -m pip install --no-cache-dir "markitdown==0.1.7" "mcp==2.0.0" fastapi uvicorn pydantic playwright \
  && python -c "import playwright; print(playwright.__version__ if hasattr(playwright, '__version__') else playwright.__file__)"

COPY --chown=agent:agent src/ljpa_reworked/services/docker/markitdown_mcp.py /home/agent/.local/lib/markitdown_mcp.py

# Нативная установка Superpowers и Ponytail.
RUN agy plugin install https://github.com/obra/superpowers \
  && agy plugin install https://github.com/DietrichGebert/ponytail \
  && agy plugin list

# Agent Skill из установленного пакета Unbrowse.
RUN mkdir -p "${HOME}/.gemini/config/skills/unbrowse" \
  && cp \
  "$(npm root --global)/unbrowse/SKILL.md" \
  "${HOME}/.gemini/config/skills/unbrowse/SKILL.md" \
  && test -s \
  "${HOME}/.gemini/config/skills/unbrowse/SKILL.md"

# Глобальная конфигурация MCP.
COPY --chown=agent:agent <<'JSON' /home/agent/.gemini/config/mcp_config.json
{
  "mcpServers": {
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "markitdown": {
      "serverUrl": "http://markitdown-mcp:3001/mcp/"
    },
    "unbrowse": {
      "command": "unbrowse",
      "args": ["mcp"]
    },
    "playwright": {
      "command": "playwright-mcp"
    },
    "imap": {
      "command": "imap-mcp-server",
      "env": {
        "IMAP_MCP_READ_ONLY": "true"
      }
    }
  }
}
JSON

# Обязательная маршрутизация через skills.
COPY --chown=agent:agent <<'RULES' /home/agent/.gemini/GEMINI.md
# Mandatory skill routing

Before every response, clarification question, plan, file inspection, tool call, or implementation action:

1. Inspect the names and descriptions of all skills available in the current context.
2. If there is even a small possibility that a skill applies, load and read it before taking any other action.
3. If the user explicitly names a skill, using it is mandatory.
4. Process and methodology skills must be applied before implementation skills.
5. When multiple skills apply, select the smallest set that fully covers the task and state their execution order.
6. Read the complete SKILL.md of every selected skill and follow all mandatory steps and checklists.
7. Before acting, briefly state: "Using <skill-name> to <purpose>."
8. Never skip a relevant skill because the task appears simple or urgent.
9. Do not load every full SKILL.md indiscriminately. Inspect names and descriptions first, then load only potentially relevant skills.
10. If no skill applies, proceed normally without inventing one.

User instructions and workspace AGENTS.md or GEMINI.md constraints take precedence, followed by applicable skill instructions.

# Persistent agent workspace

`/workspace` is the persistent writable workspace volume for this agent. Never create agent-generated files in `/app`, `/app/data`, `/app/prompts`, `/app/resources`, or the user's project tree unless the user explicitly asks to change a project file.

- Put every scratch script, temporary artifact, downloaded input, generated report, execution note, and agent-only state under `/workspace`.
- Before creating a file, reuse an existing suitable directory under `/workspace`; do not write one-off artifacts into application data directories.
- Keep `/workspace/README.md` current. For each retained file or directory, record its path, purpose, creator/task, and whether it is disposable or persistent.
- Reusable procedures and domain knowledge belong in `/workspace/skills/<skill-name>/SKILL.md`, not as loose notes. Include a trigger, steps, constraints, and verification in each skill.
- At the beginning of work, inspect `/workspace/skills` if it exists. These are workspace skills available for the current task; read each relevant `SKILL.md` before acting. When a task yields reusable knowledge, document it there as a skill and update `/workspace/README.md`.
- Do not put secrets, tokens, cookies, candidate profiles, or database contents in `/workspace` or its documentation.

# Engineering workflow precedence

For coding tasks:

1. Apply the relevant Superpowers process skill first.
2. Apply Ponytail after understanding the existing implementation.
3. Reuse existing project code before adding new code.
4. Prefer standard-library, native-platform, and already-installed solutions.
5. Do not sacrifice correctness, tests, security, validation, accessibility, or error handling for fewer lines.
6. Do not claim completion until relevant verification has actually passed.

Always use Context7 for current library and API documentation, version-specific code examples, dependency setup, configuration instructions, and questions where the installed API may differ from model memory.
RULES

# Immutable Harness application content. Runtime state is mounted only at /runtime.
COPY --chown=agent:agent prompts/ /app/prompts/
COPY --chown=agent:agent src/ljpa_reworked/services/harness/ /app/harness/
COPY --chown=agent:agent .agents/ /app/.agents/
COPY --chown=agent:agent src/ljpa_reworked/services/docker/antigravity-entrypoint.sh /usr/local/bin/antigravity-entrypoint
RUN chmod 0755 /usr/local/bin/antigravity-entrypoint \
  && cp -a "${HOME}/.gemini" "${HOME}/.gemini-default"

WORKDIR /app

# Финальная статическая проверка.
RUN node --version \
  && npm --version \
  && python --version \
  && uv --version \
  && agy --version \
  && unbrowse --version \
  && python -c "import markitdown, mcp, fastapi, uvicorn, pydantic" \
  && command -v playwright-mcp \
  && python -m json.tool \
  "${HOME}/.gemini/config/mcp_config.json" >/dev/null \
  && test -s "${HOME}/.gemini/GEMINI.md" \
  && test -s \
  "${HOME}/.gemini/config/skills/unbrowse/SKILL.md"

# Runtime state is supplied by the single writable /runtime bind mount.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/antigravity-entrypoint"]
CMD ["python3", "/app/harness/harness_server.py"]